# Personal development diary
DIARY.md

# macOS system files
.DS_Store
**/.DS_Store

# Exclude Snowflake stage files
AUDIO_VIDEO_STAGE_FILES/**
!AUDIO_VIDEO_STAGE_FILES/.gitkeep

# Exclude examples folder
examples.to.use/

# Exclude RSA key files (private keys should never be committed)
rsa_key.p8
rsa_key.pub
*.pem
*.p8

# Exclude configuration files with credentials
av.uploader/config.json
**/config.json

# Cortex Code local files
.cortex/

# Retired plans — kept locally for reference, not version controlled.
# Active plans under .snowflake/cortex/plans/ ARE tracked. Evidence worth keeping
# (e.g. the hang root-cause stacks) is carried in the active plan that supersedes them.
.snowflake/cortex/plans/completed/

# Streamlit local secrets (credentials — never commit)
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/

# Snowflake CLI deploy artifacts
output/

# Temporary migration scripts (ad-hoc, not for version control)
migration/
