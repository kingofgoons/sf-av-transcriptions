        <mxCell id="config-store" value="TRANSCRIPTION_DEPLOY.PUBLIC.SCRIPTS&#xa;00_config.sql&#xa;&#xa;single source of truth for all object names&#xa;loaded via EXECUTE IMMEDIATE FROM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#29B5E8;strokeColor=#11567F;fontColor=#000000;fontFamily=Arial;fontSize=9;" vertex="1" parent="1">
