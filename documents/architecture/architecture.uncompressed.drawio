        </mxCell>

        <mxCell id="config-view" value="V_PROJECT_CONFIG&#xa;&#xa;emitted BY 00_config.sql&#xa;owner's rights cannot read&#xa;session variables (090244),&#xa;so the app reads this view" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#29B5E8;strokeColor=#11567F;fontColor=#000000;fontFamily=Arial;fontSize=9;" vertex="1" parent="1">
