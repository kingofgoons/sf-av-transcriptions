# Personal development diary
DIARY.md

# macOS system files
.DS_Store
**/.DS_Store

# Exclude Snowflake stage files
AUDIO_VIDEO_STAGE_FILES/**
!AUDIO_VIDEO_STAGE_FILES/.gitkeep

# Downloaded SRT exports. These are customer meeting transcripts pulled out of
# TRANSCRIPTION_RESULTS by av.uploader/download_srts.py — generated artifacts, and content
# that should never land in a git history.
#
# Both rules are needed. srt_output/ is only the DEFAULT --output directory; the flag takes
# an arbitrary path (the README shows `--output ./my_srts`), so the directory rule alone
# would leave any other choice exposed. The *.srt glob is the actual safety net.
#
# No .srt file is tracked today and none is used as a test fixture — the golden corpus is
# .jsonl.gz — so the glob costs nothing. If an .srt is ever needed as a fixture, add a
# negation here rather than narrowing the glob.
av.uploader/srt_output/
*.srt

# Exclude examples folder
examples.to.use/

# Exclude RSA key files (private keys should never be committed)
rsa_key.p8
rsa_key.pub
*.pem
*.p8

# Exclude configuration files with credentials
av.uploader/config.json
**/config.json

# Deployment config working copies. scripts/00_config.sql.template IS tracked and
# holds the documented defaults; your edited copy is not, so each installation can
# target its own objects without committing local values or fighting merge
# conflicts. Create it with ./scripts/init_config.sh. Same split as
# av.uploader/config.template.json -> av.uploader/config.json above.
#
# The glob also covers parallel-deployment copies (e.g. 00_config_dev.sql). It does
# NOT match the template, which ends in .template rather than .sql.
scripts/00_config*.sql

# Cortex Code local files
.cortex/

# Retired plans — kept locally for reference, not version controlled.
# Active plans under .snowflake/cortex/plans/ ARE tracked. Evidence worth keeping
# (e.g. the hang root-cause stacks) is carried in the active plan that supersedes them.
.snowflake/cortex/plans/completed/

# Streamlit local secrets (credentials — never commit)
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/

# Snowflake CLI deploy artifacts
output/

# Temporary migration scripts (ad-hoc, not for version control)
migration/
