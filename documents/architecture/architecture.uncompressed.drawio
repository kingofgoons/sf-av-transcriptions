        <mxCell id="sf-boundary" value="Snowflake &#8212; TRANSCRIPTION_DB_V2.TRANSCRIPTION_SCHEMA_V2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#11567F;strokeColor=#0A3A54;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontStyle=1;verticalAlign=top;opacity=20;" vertex="1" parent="1">
