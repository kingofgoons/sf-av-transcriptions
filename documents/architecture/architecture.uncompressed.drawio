        <!-- ===== Ingestion ===== -->
        <mxCell id="av-stage" value="@AUDIO_VIDEO_STAGE&#xa;327 media files&#xa;(name hard-coded in notebook)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#29B5E8;strokeColor=#11567F;fontColor=#000000;fontFamily=Arial;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="150" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- ===== Orchestration ===== -->
        <mxCell id="task" value="TRANSCRIBE_NEW_FILES_TASK_V2&#xa;&#xa;NO SCHEDULE &#8212; event-driven&#xa;USER_TASK_TIMEOUT_MS = 30 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#29B5E8;strokeColor=#11567F;fontColor=#000000;fontFamily=Arial;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="145" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="TRANSCRIBE_IF_NEW_FILES()&#xa;EXECUTE AS OWNER&#xa;&#xa;ALTER STAGE REFRESH&#xa;+ DIRECTORY() diff vs results&#xa;&#xa;no new files &#8594; SKIPPED&#xa;new files &#8594; launch notebook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#29B5E8;strokeColor=#11567F;fontColor=#000000;fontFamily=Arial;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="275" width="200" height="140" as="geometry" />
        </mxCell>

