        <mxCell id="pool-boundary" value="TRANSCRIPTION_GPU_POOL_V2 &#8212; GPU_NV_S, 1-3 nodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#11567F;strokeColor=#0A3A54;fontColor=#FFFFFF;fontFamily=Arial;fontSize=10;fontStyle=1;verticalAlign=top;opacity=30;" vertex="1" parent="1">
